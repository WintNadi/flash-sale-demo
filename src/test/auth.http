### ====================================================
### BASE
### ====================================================
@baseUrl = http://localhost:8081


### ====================================================
### 3. Login maria (admin)
### ====================================================
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "maria@gmail.com",
  "password": "12345678"
}

> {%
    client.global.set("G_adminToken", response.body.token);
    client.log("Stored G_adminToken, role: " + response.body.user.role);
%}


### ====================================================
### 5. Login buyer
### ====================================================
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "password123"
}

> {%
    client.global.set("G_buyerToken", response.body.token);
    client.log("Stored G_buyerToken, role: " + response.body.user.role);
%}


### ====================================================
### 7. Buyer submits seller application
### ====================================================
POST {{baseUrl}}/api/seller-applications
Authorization: Bearer {{G_buyerToken}}
Content-Type: application/json

{
  "businessName": "Pixel Paradise",
  "description": "We sell the finest refurbished Pixel phones with a 1-year warranty and free shipping across Myanmar."
}

> {%
    client.global.set("G_applicationId", response.body.id);
    client.log("Stored G_applicationId: " + response.body.id);
%}


### ====================================================
### 11. Admin approves the application
### ====================================================
POST {{baseUrl}}/api/admin/seller-applications/{{G_applicationId}}/approve
Authorization: Bearer {{G_adminToken}}


### ====================================================
### 13. Re-login buyer (now SELLER)
### ====================================================
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "password123"
}

> {%
    client.global.set("G_buyerToken", response.body.token);
    client.log("Refreshed G_buyerToken, new role: " + response.body.user.role);
%}


### ====================================================
### 17. Seller token, wrong role — should be 403
### ====================================================
GET {{baseUrl}}/api/admin/seller-applications
Authorization: Bearer {{G_buyerToken}}


### ====================================================
### 18. Admin token — should be 200
### ====================================================
GET {{baseUrl}}/api/admin/seller-applications
Authorization: Bearer {{G_adminToken}}


### ====================================================
### 15. No token — should be 401
### ====================================================
GET {{baseUrl}}/api/admin/seller-applications