### 1. Health check
GET http://localhost:8081/api/health

### 2. Register alice
POST http://localhost:8081/api/auth/register
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "hunter2pass"
}

### 3. Login alice — capture token
# @name login
POST http://localhost:8081/api/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "hunter2pass"
}

> {%
    client.global.set("token", response.body.token);
    client.log("Token captured: " + response.body.token.substring(0, 30) + "...");
%}

### 4. List flash sales
GET http://localhost:8081/api/flash-sales

### 5. Reserve WITHOUT token (should be 403)
POST http://localhost:8081/api/flash-sales/13reserve
Content-Type: application/json

{
  "quantity": 1
}

### 6. Reserve WITH token (should be 201)
POST http://localhost:8081/api/flash-sales/14/reserve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantity": 1
}

> {%
    client.global.set("orderId", response.body.orderId);
    client.log("Order ID captured: " + response.body.orderId);
%}

### 8. Confirm order (success)
POST http://localhost:8081/api/orders/{{orderId}}/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

### 9. Confirm same order again (should be 400 - not RESERVED)
POST http://localhost:8081/api/orders/{{orderId}}/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

### 10. Confirm someone else's order (should be 400)
POST http://localhost:8081/api/orders/99999/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

### 11. Initiate payment for the reserved order
POST http://localhost:8081/api/orders/{{orderId}}/pay
Authorization: Bearer {{token}}
Content-Type: application/json

> {%
    client.global.set("clientSecret", response.body.clientSecret);
    client.log("Client secret: " + response.body.clientSecret);
%}

### 12. Get my orders
GET http://localhost:8081/api/orders/me
Authorization: Bearer {{token}}

### 13. Cancel reservation
POST http://localhost:8081/api/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json