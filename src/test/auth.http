### ========================================
### VARIABLES (must be at the top!)
### ========================================
@host = http://localhost:8081

### ========================================
### PUBLIC ENDPOINTS
### ========================================

### 1. Health check
GET {{host}}/api/health

### 2. List flash sales (public)
GET {{host}}/api/flash-sales

### ========================================
### AUTH — Register
### ========================================

### 3. Register buyer
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "password123"
}

### ========================================
### AUTH — Login & capture tokens
### ========================================

### 4. Login as buyer — captures {{buyerToken}}
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email":"maria@gmail.com",
  "password": "12345678"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.log("Admin tored");
%}

### ========================================
### AUTHENTICATED REQUESTS
### ========================================

### 5. Get current user (buyer token)
GET {{host}}/api/auth/me
Authorization: Bearer {{buyerToken}}

### 6. Get current user — no token (should be 401)
GET {{host}}/api/auth/me

### ========================================
### FLASH SALE FLOW
### ========================================

### 7. Reserve WITHOUT token (should be 401/403)
POST {{host}}/api/flash-sales/1/reserve
Content-Type: application/json

{
  "quantity": 1
}

### 8. Reserve WITH token (should be 201)
POST {{host}}/api/flash-sales/1/reserve
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "quantity": 1
}

> {%
    client.global.set("orderId", response.body.orderId);
    client.log("Order ID: " + response.body.orderId);
%}

### 9. Get my orders
GET {{host}}/api/orders/me
Authorization: Bearer {{buyerToken}}

### 10. Confirm order
POST {{host}}/api/orders/{{orderId}}/confirm
Authorization: Bearer {{buyerToken}}

### 11. Confirm again (should fail — already confirmed)
POST {{host}}/api/orders/{{orderId}}/confirm
Authorization: Bearer {{buyerToken}}

### ========================================
### AUTHORIZATION TESTS
### ========================================

### 12. Buyer tries admin path (should be 403)
GET {{host}}/api/admin/test
Authorization: Bearer {{buyerToken}}

### 13. Admin tries admin path (needs admin user seeded first)
GET {{host}}/api/admin/test
Authorization: Bearer {{adminToken}}